theorem PEqualNP.Outside.L_meta_53275 : ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 7 ∧ ∀ i j : Fin 5, C.eval (List.ofFn fun k : Fin 5 => decide (k = i ∨ k = j)) = (17052115 : ℕ).testBit (5 * min i.val j.val + max i.val j.val) := by
  exact ⟨PEqualNP.Outside.L_meta_53275_aux.circ, PEqualNP.Outside.L_meta_53275_aux.h_ok, PEqualNP.Outside.L_meta_53275_aux.h_sz, by decide +kernel⟩
