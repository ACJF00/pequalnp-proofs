 have hm:k % 6 < 6:=Nat.mod_lt k (by decide)
 rw [qo,qo] at h1
 simp only [hm,↓reduceIte,Nat.div_add_mod] at h1
 exact h1
lemma z1 (x i:Nat):z6 (x / 64) i=z6 x (i+1):=by
