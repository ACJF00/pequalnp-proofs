lemma q113 (x:Nat × Nat) (xs:List (Nat × Nat)):(q62 x xs).Perm (x::xs):=by
 induction xs with | nil => exact lPR _ | cons a t ih => simp only [q62];split;exact lPR _;exact (lPC a ih).trans (List.Perm.swap x a t)
lemma q64 (xs:List (Nat × Nat)):(q125 xs).Perm xs:=by
 induction xs with | nil => exact List.Perm.nil | cons a t ih => exact (q113 a (q125 t)).trans (lPC a ih)
lemma kg {n:Nat} (rp shTT:Nat) (ws:List (BFn n × Nat)) :
   q72 shTT (encWs (allRows n rp shTT) ws)=encTTWs n ws:=by
 induction ws with
 | nil => rfl
 | cons p t ih =>
   rcases p with ⟨g,tg⟩;simp only [qy,q49,q72,v5,ih]
   have hsh:=q116 (n:=n) (q106 rp shTT) g
   rw [jj rp shTT] at hsh;rw [allRows,hsh]
lemma yk {n:Nat} {f:BFn n} {g:List (Nat × Nat × Nat × Nat)} (hg:vh f g) (ws:List (BFn n × Nat)) :
   ∃ π:(Fin n->Bool)->(Fin n->Bool),Function.Bijective π/\(∀ x,f (π x)=f x) /\
     wx g (encTTWs n ws)=encTTWs n (ws.map fun p => ((fun x => p.1 (π x)),p.2)):=by
 obtain ⟨π,hbij,hfix,happ⟩:=hg;refine ⟨π,hbij,hfix,?_⟩
 induction ws with | nil => rfl | cons p t ih => rcases p with ⟨h,tg⟩;simp only [q49,lMC,wx,v5,happ,ih]
lemma q19 {n:Nat} {f:BFn n} {g:List (Nat × Nat × Nat × Nat)} (hg:vh f g)
   (ws:List (Nat × Nat)) (ws_b:List (BFn n × Nat)) (hp:ws.Perm (encTTWs n ws_b)) :
   ∃ π:(Fin n->Bool)->(Fin n->Bool),Function.Bijective π/\(∀ x,f (π x)=f x) /\
     (q69 g ws).Perm (encTTWs n (ws_b.map fun p => ((fun x => p.1 (π x)),p.2))):=by
 unfold q69;dsimp only;split
 . obtain ⟨π,hbij,hfix,hmg⟩:=yk hg ws_b;refine ⟨π,hbij,hfix,?_⟩
   have hmap_eq:∀ l,wx g l=l.map (fun p => (ym g p.1,p.2)):=fun l => by
     induction l with | nil => rfl | cons p t ih => simp [wx,v5,ih]
   have hmgp:(wx g ws).Perm (wx g (encTTWs n ws_b)):=by rw [hmap_eq,hmap_eq];exact hp.map _
   exact (q64 _).trans (hmgp.trans (by rw [hmg]))
 . exact ⟨id,Function.bijective_id,fun _ => rfl,by simpa using hp⟩
lemma q20 {n:Nat} {f:BFn n} (gens:List (List (Nat × Nat × Nat × Nat)))
   (hgens:∀ g ∈ gens,vh f g) (ws:List (Nat × Nat)) (ws_b:List (BFn n × Nat)) (hp:ws.Perm (encTTWs n ws_b)) :
   ∃ π:(Fin n->Bool)->(Fin n->Bool),Function.Bijective π/\(∀ x,f (π x)=f x) /\
     (q35 gens ws).Perm (encTTWs n (ws_b.map fun p => ((fun x => p.1 (π x)),p.2))):=by
 induction gens generalizing ws ws_b with
 | nil => exact ⟨id,Function.bijective_id,fun _ => rfl,by simpa [q35] using hp⟩
 | cons g rest ih =>
   obtain ⟨π1,hb1,hf1,hp1⟩:=q19 (hgens g (by simp)) ws ws_b hp
   obtain ⟨π2,hb2,hf2,hp2⟩:=ih (fun g' hm => hgens g' (List.mem_cons_of_mem g hm)) (q69 g ws) _ hp1
   exact ⟨π1 ∘ π2,hb1.comp hb2,fun x => by simp [hf1,hf2],by simpa [q35,lMMp,fCD] using hp2⟩
lemma q152 {n:Nat} {f:BFn n} (gens:List (List (Nat × Nat × Nat × Nat)))
   (hgens:∀ g ∈ gens,vh f g) (ws_b:List (BFn n × Nat)) :
   ∃ π:(Fin n->Bool)->(Fin n->Bool),Function.Bijective π/\(∀ x,f (π x)=f x) /\
     (q186 gens (encTTWs n ws_b)).Perm (encTTWs n (ws_b.map fun p => ((fun x => p.1 (π x)),p.2))):=by
 unfold q186;have hs0:=q64 (encTTWs n ws_b)
 cases gens with
 | nil => exact ⟨id,Function.bijective_id,fun _ => rfl,by simpa using hs0⟩
 | cons g rest =>
   cases rest with
   | nil => exact q19 (hgens g (by simp)) _ ws_b hs0
   | cons g2 rest2 =>
     obtain ⟨π1,hb1,hf1,hp1⟩:=q20 (g::g2::rest2) hgens _ ws_b hs0
     obtain ⟨π2,hb2,hf2,hp2⟩:=q20 (g::g2::rest2) hgens _ _ hp1
     exact ⟨π1 ∘ π2,hb1.comp hb2,fun x => by simp [hf1,hf2],by simpa [lMMp,fCD] using hp2⟩
def w8 (n:Nat) (f:BFn n):Bool :=
 let t:=encTT n f;!(Nat.beq t 0)&&!(Nat.beq t (2 ^ (2 ^ n) - 1))
lemma ju (n:Nat) (f:BFn n) (h:w8 n f=true) :
   ∃ y y':Fin n->Bool,f y≠f y':=by
 unfold w8 at h;simp only [bAT,bNT,zh] at h
 obtain ⟨hne0,hne1⟩:=h
 have hex1:∃ r < 2 ^ n,f (q1 n r)=true:=by
   by_contra hall;push Not at hall;apply hne0;apply nEQ;intro r
   rw [vr,nZT];split;exact Bool.eq_false_iff.2 (hall r ‹_›);rfl
 have hex0:∃ r < 2 ^ n,f (q1 n r)=false:=by
   by_contra hall;push Not at hall;apply hne1;apply nEQ;intro r
   rw [vr,nTB];split
   . rename_i hr;have:f (q1 n r)=true:=by cases hf:f (q1 n r);exact absurd hf (hall r hr);rfl
     simp [hr,this]
   . rename_i hr;simp [hr]
 obtain ⟨r1,_,h1⟩:=hex1;obtain ⟨r0,_,h0⟩:=hex0
 exact ⟨q1 n r1,q1 n r0,by rw [h1,h0];decide⟩
def q77 (n:Nat) (f:BFn n):Bool :=
 (List.finRange n).all fun v =>
   (List.range (2 ^ n)).any fun r => let x:=q1 n r;f (Function.update x v (!x v))!=f x
lemma q44 (n:Nat) (f:BFn n) (h:q77 n f=true) :
   ∀ v:Fin n,∃ x:Fin n->Bool,f (Function.update x v (!x v))≠f x:=by
 intro v;have h1:=List.all_eq_true.1 h v (List.mem_finRange v)
 obtain ⟨r,_,hr⟩:=List.any_eq_true.1 h1;exact ⟨q1 n r,bne_iff_ne.1 hr⟩
-- Certificate layer: bounded search `srch`, refuted states `Den`, and
-- refutation rows whose surviving successors are either searched inline or refuted rows.
def srch (c:Cfg):Nat->List (Nat × Nat)->Bool
 | 0,ws => ws.any fun p => Nat.beq p.1 c.goalv
 | s+1,ws => Nat.ble (q164 ws) (s+2)&&scanAll c s ws (srch c s)

theorem srch_ok {n:Nat} {f:BFn n} {rp:Nat} {c:Cfg} (hc:CfgOk n f rp c) :
    ∀ (s:Nat),s<=11->∀ {b:List (BFn n × Nat)},AllTagsLe3 b->TR f s b->srch c s (eW rp c b)=true := by
 intro s
 induction s with
 | zero =>
   intro _ b _ run
   obtain ⟨t,rfl⟩:=run.inv_zero
   simp [srch,eW,eL,encWs,hc.goalv_eq,aR]
 | succ k ih =>
   intro hs b tb run
   have hlen:(eW rp c b).length<=k+2:=by simpa [eW,encWs] using run.len_le
   simp only [srch,q187,Bool.and_eq_true]
   exact ⟨by simpa using hlen,q17 hc (by omega) tb run (srch c k) (fun _ t x => ih (by omega) t x)⟩

theorem perm_lift {α β:Type} (e:α->β) {u v:List β} (h:u.Perm v) :
    ∀ l:List α,l.map e=u->∃ l':List α,l'.Perm l/\l'.map e=v := by
 induction h with
 | nil => intro l he;exact ⟨l,List.Perm.refl l,he⟩
 | cons x _ ih =>
   intro l he
   cases l with
   | nil => simp at he
   | cons a t =>
     simp only [List.map_cons,List.cons.injEq] at he
     obtain ⟨t',pt,mt⟩:=ih t he.2
     exact ⟨a::t',pt.cons a,by simp [mt,he.1]⟩
 | swap x y l1 =>
   intro l he
   match l,he with
   | a::b::t,he =>
     simp only [List.map_cons,List.cons.injEq] at he
     exact ⟨b::a::t,List.Perm.swap a b t,by simp [he.1,he.2.1,he.2.2]⟩
 | trans _ _ ih1 ih2 =>
   intro l he
   obtain ⟨l1,p1,m1⟩:=ih1 l he
   obtain ⟨l2,p2,m2⟩:=ih2 l1 m1
   exact ⟨l2,p2.trans p1,m2⟩

def truth (n bits:Nat) (x:Fin n->Bool):Bool :=
 bits.testBit (∑ i:Fin n,if x i then 2 ^ (i:Nat) else 0)

theorem drop_lb {n m cost:Nat} (f:BFn n) (g:BFn m) (v:Fin n) (π:Fin n->Fin m)
    (eq:∀ x,f (Function.update (x ∘ π) v false)=g x)
    (lb:∀ s,HasCircuitSize m g s->cost<=s) :
    ∀ s,HasCircuitSize n (fun x => f (Function.update x v false)) s->cost<=s := by
 intro s hs
 have h:=yn π _ s hs
 have e:(fun x:Fin m->Bool => (fun x:Fin n->Bool => f (Function.update x v false)) (x ∘ π))=g:=funext eq
 rw [e] at h
 exact lb s h

-- Symmetry-reduced table layer: banks hold truth tables (2^n bits) and tags; successors are
-- compared with the children after canonicalisation by automorphisms of f (q186 / q152).
def etb (rows:List Nat) (t:Nat):Nat:=rows.foldr (fun r acc => acc*2+if t.testBit r then 1 else 0) 0

theorem etb_ok {n:Nat} (g:BFn n) :
    ∀ rows:List Nat,(∀ r ∈ rows,r < 2 ^ n)->etb rows (encTT n g)=encL rows g
 | [],_ => rfl
 | r::rs,h => by
   have hr:r < 2 ^ n:=h r (by simp)
   have ih:=etb_ok g rs (fun x hx => h x (by simp [hx]))
   simp only [etb,encL,List.foldr_cons] at ih ⊢
   rw [ih,vr,if_pos hr]

def decW (rows:List Nat) (u:List (Nat × Nat)):List (Nat × Nat):=u.map fun p => (etb rows p.1,p.2)

def DenT {n:Nat} (f:BFn n) (k:Nat) (u:List (Nat × Nat)):Prop :=
 ∀ b,AllTagsLe3 b->(encTTWs n b).Perm u->¬TR f k b

theorem row_denT {n:Nat} {f:BFn n} {rp:Nat} {c:Cfg} (hc:CfgOk n f rp c)
    (hr:∀ r ∈ aR n rp c,r < 2 ^ n) {k:Nat} (hk:k<=10)
    (gens:List (List (Nat × Nat × Nat × Nat))) (hg:∀ g ∈ gens,vh f g)
    (u:List (Nat × Nat)) (chs:List (List (Nat × Nat))) (hch:∀ v ∈ chs,DenT f k v)
    (hrow:scanAll c k (decW (aR n rp c) u)
      (fun w => Nat.ble (q164 w) (k+1)&&!(chs.contains (q186 gens (q72 c.shTT w)))&&srch c k w)=false) :
    DenT f (k+1) u := by
 intro b tb hp run
 obtain ⟨b',pb,hb'⟩:=perm_lift (fun z:BFn n × Nat => (encTT n z.1,z.2)) hp b rfl
 have tb':AllTagsLe3 b':=fun x hx => tb x (pb.mem_iff.mp hx)
 have run':=TagRun.perm pb.symm run
 have he:eW rp c b'=decW (aR n rp c) u:=by
   rw [← hb']
   simp only [eW,encWs,decW,List.map_map]
   apply List.map_congr_left
   intro z _
   simp only [Function.comp,etb_ok z.1 _ hr]
 have yes:=q17 hc hk tb' run'
   (fun w => Nat.ble (q164 w) (k+1)&&!(chs.contains (q186 gens (q72 c.shTT w)))&&srch c k w) (by
   intro z tz rz
   simp only [Bool.and_eq_true,Bool.not_eq_true']
   refine ⟨⟨?_,?_⟩,srch_ok hc k (by omega) tz rz⟩
   . have:=rz.len_le
     simp only [q187,eW,encWs,List.length_map,Nat.ble_eq]
     omega
   . by_contra hin
     have hm:q186 gens (q72 c.shTT (eW rp c z)) ∈ chs:=by simpa using hin
     rw [show eW rp c z=encWs (allRows n rp c.shTT) z from rfl,kg] at hm
     obtain ⟨π,hbij,hfix,hpp⟩:=q152 gens hg z
     exact hch _ hm (z.map fun p => ((fun x => p.1 (π x)),p.2))
       (fun x hx => by
         obtain ⟨y,hy,rfl⟩:=List.mem_map.mp hx
         exact tz y hy) hpp.symm (wp π hbij hfix rz))
 rw [he,hrow] at yes
 cases yes

structure Tab where
 lv:Nat->Nat
 ix:Nat->List (Nat × Nat)
 kd:Nat->List Nat
 tw:Nat->Nat
 fw:Nat->Nat

def Tab.bk (t:Tab) (i:Nat):List (Nat × Nat):=(t.ix i).map fun p => (t.tw p.1,p.2)
def Tab.fb (t:Tab) (i:Nat):List (Nat × Nat):=(t.ix i).map fun p => (t.fw p.1,p.2)

def tabRow (c:Cfg) (gens:List (List (Nat × Nat × Nat × Nat))) (t:Tab) (i:Nat):Bool :=
 match t.lv i with
 | 0 => false
 | k+1 => !(scanAll c k (t.fb i)
     (fun w => Nat.ble (q164 w) (k+1)&&!(((t.kd i).map t.bk).contains (q186 gens (q72 c.shTT w)))&&srch c k w))

def tabOrd (t:Tab) (N NW:Nat):Bool :=
 (List.range N).all fun i => Nat.ble (t.lv i) 11&&(t.ix i).all (fun p => Nat.blt p.1 NW)&&
   (t.kd i).all fun j => Nat.blt j N&&Nat.beq (t.lv j+1) (t.lv i)

theorem tab_ok {n:Nat} {f:BFn n} {rp:Nat} {c:Cfg} (hc:CfgOk n f rp c)
    (hr:∀ r ∈ aR n rp c,r < 2 ^ n)
    (gens:List (List (Nat × Nat × Nat × Nat))) (hg:∀ g ∈ gens,vh f g) (t:Tab) (N NW:Nat)
    (hw:∀ j < NW,t.fw j=etb (aR n rp c) (t.tw j))
    (hrows:∀ i < N,tabRow c gens t i=true) (hord:tabOrd t N NW=true) :
    ∀ i < N,DenT f (t.lv i) (t.bk i) := by
 have ord:∀ i < N,t.lv i<=11/\(∀ p ∈ t.ix i,p.1 < NW)/\∀ j ∈ t.kd i,j < N/\t.lv j+1=t.lv i:=by
   intro i hi
   have h:=List.all_eq_true.mp hord i (List.mem_range.mpr hi)
   simp only [Bool.and_eq_true,Nat.ble_eq,List.all_eq_true,Nat.blt_eq,Nat.beq_eq] at h
   exact ⟨h.1.1,h.1.2,h.2⟩
 have dec:∀ i < N,t.fb i=decW (aR n rp c) (t.bk i):=by
   intro i hi
   simp only [Tab.fb,Tab.bk,decW,List.map_map]
   apply List.map_congr_left
   intro p hp
   simp only [Function.comp]
   rw [hw p.1 ((ord i hi).2.1 p hp)]
 have aux:∀ k,∀ i < N,t.lv i=k->DenT f k (t.bk i):=by
   intro k
   induction k with
   | zero =>
     intro i hi hk
     have h:=hrows i hi
     simp only [tabRow,hk] at h
     cases h
   | succ k ih =>
     intro i hi hk
     have h:=hrows i hi
     simp only [tabRow,hk] at h
     rw [dec i hi] at h
     have hk10:k<=10:=by have:=(ord i hi).1;omega
     apply row_denT hc hr hk10 gens hg (t.bk i) ((t.kd i).map t.bk) _ (by simpa using h)
     intro v hv
     obtain ⟨j,hj,rfl⟩:=List.mem_map.mp hv
     obtain ⟨hjN,hjl⟩:=(ord i hi).2.2 j hj
     exact ih j hjN (by omega)
 exact fun i hi => aux _ i hi rfl

def spanB (P:Nat->Bool):Nat->Nat->Bool
 | 0,_ => true
 | m+1,a => P a&&spanB P m (a+1)

theorem spanB_ok (P:Nat->Bool) :
    ∀ (m a:Nat),spanB P m a=true->∀ i,a<=i->i < a+m->P i=true
 | 0,_,_,i,h1,h2 => by omega
 | m+1,a,h,i,h1,h2 => by
   simp only [spanB,Bool.and_eq_true] at h
   by_cases e:i=a
   . subst e;exact h.1
   . exact spanB_ok P m (a+1) h.2 i (by omega) (by omega)

def pk (D:Nat->Nat) (per w i:Nat):Nat:=(D (i/per) >>> (w*(i%per)))%2 ^ w

def unB:Nat->Nat->List (Nat × Nat)
 | 0,_ => []
 | m+1,x => if x=0 then [] else ((x%16384-1)/4,(x%16384-1)%4)::unB m (x/16384)

theorem lb_denT {n cap:Nat} (hc:cap<=11) (f:BFn n)
    (tags:Fin n->Nat) (xsT:List (Nat × Nat))
    (init:xsT=encTTWs n (List.ofFn fun i:Fin n => ((fun x:Fin n->Bool => x i),tags i)))
    (tagcap:∀ v,tags v<=3) (nc:w8 n f=true) (dep:q77 n f=true)
    (htag:∀ v:Fin n,tags v=0 \/
      (tags v=1/\(∃ x y,f (Function.update x v false)≠f (Function.update y v false))/\
        ∀ s',HasCircuitSize n (fun x => f (Function.update x v false)) s'->cap-1<=s') \/
      (tags v=3/\(∃ x y,f (Function.update x v false)≠f (Function.update y v false))/\
        ∀ s',HasCircuitSize n (fun x => f (Function.update x v false)) s'->cap-2<=s'))
    (den:∀ s ≤ cap,n<=s+1->DenT f s xsT) :
    ∀ t,HasCircuitSize n f t->cap+1<=t := by
 intro t ht
 by_contra bad
 obtain ⟨k,hk,run⟩:=q88 f cap tags (ju _ _ nc) (q44 _ _ dep) htag t (by omega) ht
 have hn:n<=k+1:=by simpa using run.len_le
 exact den k hk hn _ (fun p hp => by
   obtain ⟨i,rfl⟩:=List.mem_ofFn.mp hp
   exact tagcap i) (by rw [init]) run

-- Duality: a fan-in-two AND/OR/NOT circuit for f gives one of the same size for x ↦ ¬f(¬x).
-- Gates are swapped AND↔OR; reads of missing wires (which give false) are folded into constants.
def dualGate (k:Nat) (g:Gate):Gate :=
 match g with
 | ⟨GateOp.and,l⟩ => if l.all (fun i => decide (i < k)) then ⟨GateOp.or,l⟩ else ⟨GateOp.and,[]⟩
 | ⟨GateOp.or,l⟩ => ⟨GateOp.and,l.filter (fun i => decide (i < k))⟩
 | ⟨GateOp.not,[]⟩ => ⟨GateOp.or,[]⟩
