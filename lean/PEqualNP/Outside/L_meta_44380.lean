   invF meetF joinF (fun _ => false) (fun _ => true) f
   invF meetF joinF (fun _ => false) (fun _ => true) f
   rfl rfl (funext hfix) (fun _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) s ws h
def z6 (x i:Nat):Nat:=(x / 64 ^ i) % 64
lemma q185 (i:Nat) : 64 ^ i=2 ^ (6*i):=by
