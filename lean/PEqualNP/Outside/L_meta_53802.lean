theorem PEqualNP.Outside.L_meta_53802 : ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ 12 ∧ ∀ i j : Fin 6, C.eval (List.ofFn fun k : Fin 6 => decide (k = i ∨ k = j)) = (4295486 : ℕ).testBit (6 * min i.val j.val + max i.val j.val) := by
  exact ⟨PEqualNP.Outside.L_meta_53802_aux.circ, PEqualNP.Outside.L_meta_53802_aux.h_ok, PEqualNP.Outside.L_meta_53802_aux.h_sz, by decide +kernel⟩
